# Normalize line endings — the repo is authored on Windows and macOS/Linux.
* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.dart text eol=lf
*.kt   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf

# Batch/PowerShell scripts, if ever added, keep CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
