{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Alan Mobile Design System (AMDS) v1.0 - Single source of truth for all design tokens. W3C Design Tokens Community Group format. Consumed by Style Dictionary / Tokens Studio to generate platform themes.",
  "meta": {
    "name": "Alan Mobile Design System",
    "abbr": "AMDS",
    "version": "1.0.0",
    "owner": "Design Systems Team",
    "license": "Internal - [COMPANY_NAME]",
    "platforms": ["android", "ios", "flutter", "react-native", "web-preview"]
  },

  "color": {
    "$type": "color",

    "brand": {
      "green": {
        "50":  { "$value": "#F0FDF4" },
        "100": { "$value": "#DCFCE7" },
        "200": { "$value": "#BBF7D0" },
        "300": { "$value": "#86EFAC" },
        "400": { "$value": "#4ADE80" },
        "500": { "$value": "#22C55E" },
        "600": { "$value": "#16A34A" },
        "700": { "$value": "#15803D" },
        "800": { "$value": "#166534" },
        "900": { "$value": "#14532D" },
        "950": { "$value": "#052E16" }
      }
    },

    "neutral": {
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F8FAFC" },
      "100": { "$value": "#F1F5F9" },
      "200": { "$value": "#E2E8F0" },
      "300": { "$value": "#CBD5E1" },
      "400": { "$value": "#94A3B8" },
      "500": { "$value": "#64748B" },
      "600": { "$value": "#475569" },
      "700": { "$value": "#334155" },
      "800": { "$value": "#1E293B" },
      "900": { "$value": "#0F172A" },
      "950": { "$value": "#020617" },
      "1000":{ "$value": "#000000" }
    },

    "amber": {
      "50":  { "$value": "#FFFBEB" },
      "100": { "$value": "#FEF3C7" },
      "400": { "$value": "#FBBF24" },
      "500": { "$value": "#F59E0B" },
      "600": { "$value": "#D97706" },
      "700": { "$value": "#B45309" }
    },
    "red": {
      "50":  { "$value": "#FEF2F2" },
      "100": { "$value": "#FEE2E2" },
      "400": { "$value": "#F87171" },
      "500": { "$value": "#EF4444" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" }
    },
    "sky": {
      "50":  { "$value": "#F0F9FF" },
      "100": { "$value": "#E0F2FE" },
      "400": { "$value": "#38BDF8" },
      "500": { "$value": "#0EA5E9" },
      "600": { "$value": "#0284C7" },
      "700": { "$value": "#0369A1" }
    }
  },

  "theme": {
    "$type": "color",
    "light": {
      "brand":              { "$value": "{color.brand.green.600}" },
      "primary":            { "$value": "{color.brand.green.600}" },
      "primaryHover":       { "$value": "{color.brand.green.700}" },
      "primaryPressed":     { "$value": "{color.brand.green.800}" },
      "primaryContainer":   { "$value": "{color.brand.green.100}" },
      "onPrimary":          { "$value": "{color.neutral.0}" },
      "onPrimaryContainer": { "$value": "{color.brand.green.900}" },
      "secondary":          { "$value": "{color.brand.green.500}" },
      "onSecondary":        { "$value": "{color.neutral.0}" },
      "accent":             { "$value": "{color.sky.600}" },

      "background":         { "$value": "{color.neutral.50}" },
      "onBackground":       { "$value": "{color.neutral.900}" },
      "surface":            { "$value": "{color.neutral.0}" },
      "surfaceVariant":     { "$value": "{color.neutral.100}" },
      "surfaceRaised":      { "$value": "{color.neutral.0}" },
      "onSurface":          { "$value": "{color.neutral.900}" },
      "onSurfaceVariant":   { "$value": "{color.neutral.500}" },

      "textPrimary":        { "$value": "{color.neutral.900}" },
      "textSecondary":      { "$value": "{color.neutral.500}" },
      "textTertiary":       { "$value": "{color.neutral.400}", "$description": "a.k.a. Text Muted" },
      "textDisabled":       { "$value": "{color.neutral.300}" },
      "disabled":           { "$value": "{color.neutral.300}" },
      "textOnColor":        { "$value": "{color.neutral.0}" },
      "textLink":           { "$value": "{color.brand.green.700}" },

      "border":             { "$value": "{color.neutral.200}" },
      "borderStrong":       { "$value": "{color.neutral.300}" },
      "borderFocus":        { "$value": "{color.brand.green.600}" },
      "divider":            { "$value": "{color.neutral.200}" },

      "success":            { "$value": "{color.brand.green.600}" },
      "successContainer":   { "$value": "{color.brand.green.50}" },
      "onSuccessContainer": { "$value": "{color.brand.green.800}" },
      "warning":            { "$value": "{color.amber.600}" },
      "warningContainer":   { "$value": "{color.amber.50}" },
      "onWarningContainer": { "$value": "{color.amber.700}" },
      "danger":             { "$value": "{color.red.600}" },
      "dangerContainer":    { "$value": "{color.red.50}" },
      "onDangerContainer":  { "$value": "{color.red.700}" },
      "info":               { "$value": "{color.sky.600}" },
      "infoContainer":      { "$value": "{color.sky.50}" },
      "onInfoContainer":    { "$value": "{color.sky.700}" },

      "overlayScrim":       { "$value": "rgba(15, 23, 42, 0.48)" },
      "skeletonBase":       { "$value": "{color.neutral.200}" },
      "skeletonSheen":      { "$value": "{color.neutral.100}" }
    },

    "dark": {
      "brand":              { "$value": "{color.brand.green.500}" },
      "primary":            { "$value": "{color.brand.green.400}" },
      "primaryHover":       { "$value": "{color.brand.green.300}" },
      "primaryPressed":     { "$value": "{color.brand.green.200}" },
      "primaryContainer":   { "$value": "{color.brand.green.900}" },
      "onPrimary":          { "$value": "{color.brand.green.950}" },
      "onPrimaryContainer": { "$value": "{color.brand.green.100}" },
      "secondary":          { "$value": "{color.brand.green.500}" },
      "onSecondary":        { "$value": "{color.brand.green.950}" },
      "accent":             { "$value": "{color.sky.400}" },

      "background":         { "$value": "{color.neutral.950}" },
      "onBackground":       { "$value": "{color.neutral.50}" },
      "surface":            { "$value": "{color.neutral.900}" },
      "surfaceVariant":     { "$value": "{color.neutral.800}" },
      "surfaceRaised":      { "$value": "{color.neutral.800}" },
      "onSurface":          { "$value": "{color.neutral.50}" },
      "onSurfaceVariant":   { "$value": "{color.neutral.400}" },

      "textPrimary":        { "$value": "{color.neutral.50}" },
      "textSecondary":      { "$value": "{color.neutral.400}" },
      "textTertiary":       { "$value": "{color.neutral.500}", "$description": "a.k.a. Text Muted" },
      "textDisabled":       { "$value": "{color.neutral.700}" },
      "disabled":           { "$value": "{color.neutral.700}" },
      "textOnColor":        { "$value": "{color.neutral.950}" },
      "textLink":           { "$value": "{color.brand.green.400}" },

      "border":             { "$value": "{color.neutral.700}" },
      "borderStrong":       { "$value": "{color.neutral.600}" },
      "borderFocus":        { "$value": "{color.brand.green.400}" },
      "divider":            { "$value": "{color.neutral.800}" },

      "success":            { "$value": "{color.brand.green.400}" },
      "successContainer":   { "$value": "rgba(34, 197, 94, 0.16)" },
      "onSuccessContainer": { "$value": "{color.brand.green.200}" },
      "warning":            { "$value": "{color.amber.400}" },
      "warningContainer":   { "$value": "rgba(245, 158, 11, 0.16)" },
      "onWarningContainer": { "$value": "{color.amber.100}" },
      "danger":             { "$value": "{color.red.400}" },
      "dangerContainer":    { "$value": "rgba(239, 68, 68, 0.16)" },
      "onDangerContainer":  { "$value": "{color.red.100}" },
      "info":               { "$value": "{color.sky.400}" },
      "infoContainer":      { "$value": "rgba(14, 165, 233, 0.16)" },
      "onInfoContainer":    { "$value": "{color.sky.100}" },

      "overlayScrim":       { "$value": "rgba(2, 6, 23, 0.64)" },
      "skeletonBase":       { "$value": "{color.neutral.800}" },
      "skeletonSheen":      { "$value": "{color.neutral.700}" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "SF Pro Text", "Roboto", "system-ui", "sans-serif"] },
      "mono":  { "$value": ["JetBrains Mono", "SF Mono", "Roboto Mono", "monospace"] },
      "numeric": { "$value": ["Inter", "SF Pro Display", "Roboto", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    }
  },

  "typography": {
    "$type": "typography",
    "displayLarge":  { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.bold}",     "fontSize": "36px", "lineHeight": "44px", "letterSpacing": "-0.02em" } },
    "displayMedium": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.bold}",     "fontSize": "32px", "lineHeight": "40px", "letterSpacing": "-0.02em" } },
    "displaySmall":  { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.bold}",     "fontSize": "28px", "lineHeight": "36px", "letterSpacing": "-0.01em" } },
    "headingLarge":  { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.semibold}", "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.01em" } },
    "headingMedium": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.semibold}", "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "-0.01em" } },
    "headingSmall":  { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.semibold}", "fontSize": "18px", "lineHeight": "26px", "letterSpacing": "0em" } },
    "titleLarge":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.semibold}", "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0em" } },
    "titleMedium":   { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.medium}",   "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0.005em" } },
    "bodyLarge":     { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.regular}",  "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0em" } },
    "bodyMedium":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.regular}",  "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0em" } },
    "bodySmall":     { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.regular}",  "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0.005em" } },
    "label":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.medium}",   "fontSize": "14px", "lineHeight": "16px", "letterSpacing": "0.01em" } },
    "labelSmall":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.medium}",   "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.02em" } },
    "caption":       { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.regular}",  "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.01em" } },
    "overline":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.semibold}", "fontSize": "11px", "lineHeight": "16px", "letterSpacing": "0.08em" } }
  },

  "space": {
    "$type": "dimension",
    "0":   { "$value": "0px" },
    "1":   { "$value": "4px" },
    "2":   { "$value": "8px" },
    "3":   { "$value": "12px" },
    "4":   { "$value": "16px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "2xl":  { "$value": "32px" },
    "full": { "$value": "9999px" }
  },

  "borderWidth": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "hairline": { "$value": "1px" },
    "thin": { "$value": "1.5px" },
    "thick": { "$value": "2px" },
    "focus": { "$value": "2px" }
  },

  "size": {
    "$type": "dimension",
    "touchTargetMin": { "$value": "44px" },
    "touchTargetComfortable": { "$value": "48px" },
    "iconXs": { "$value": "16px" },
    "iconSm": { "$value": "20px" },
    "iconMd": { "$value": "24px" },
    "iconLg": { "$value": "32px" },
    "iconXl": { "$value": "40px" },
    "avatarXs": { "$value": "24px" },
    "avatarSm": { "$value": "32px" },
    "avatarMd": { "$value": "40px" },
    "avatarLg": { "$value": "56px" },
    "avatarXl": { "$value": "80px" },
    "buttonHeightSm": { "$value": "36px" },
    "buttonHeightMd": { "$value": "44px" },
    "buttonHeightLg": { "$value": "52px" },
    "fieldHeight": { "$value": "48px" },
    "appBarHeight": { "$value": "56px" },
    "bottomNavHeight": { "$value": "64px" },
    "fabSize": { "$value": "56px" },
    "fabSizeSmall": { "$value": "40px" }
  },

  "shadow": {
    "$type": "shadow",
    "elevation1": { "$value": { "color": "rgba(15, 23, 42, 0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "elevation2": { "$value": [
      { "color": "rgba(15, 23, 42, 0.08)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-1px" },
      { "color": "rgba(15, 23, 42, 0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    ] },
    "elevation3": { "$value": [
      { "color": "rgba(15, 23, 42, 0.10)", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" },
      { "color": "rgba(15, 23, 42, 0.05)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-1px" }
    ] },
    "elevation4": { "$value": [
      { "color": "rgba(15, 23, 42, 0.12)", "offsetX": "0px", "offsetY": "12px", "blur": "20px", "spread": "-4px" },
      { "color": "rgba(15, 23, 42, 0.06)", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" }
    ] },
    "elevation5": { "$value": [
      { "color": "rgba(15, 23, 42, 0.16)", "offsetX": "0px", "offsetY": "24px", "blur": "40px", "spread": "-8px" },
      { "color": "rgba(15, 23, 42, 0.08)", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "-4px" }
    ] }
  },

  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "appBar": { "$value": 200 },
    "drawer": { "$value": 300 },
    "bottomSheet": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 },
    "tooltip": { "$value": 700 }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "100ms" },
      "fast":    { "$value": "150ms" },
      "base":    { "$value": "200ms" },
      "moderate":{ "$value": "250ms" },
      "slow":    { "$value": "300ms" },
      "slower":  { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":     { "$value": [0.2, 0.0, 0.0, 1.0] },
      "decelerate":   { "$value": [0.0, 0.0, 0.0, 1.0] },
      "accelerate":   { "$value": [0.3, 0.0, 1.0, 1.0] },
      "emphasized":   { "$value": [0.2, 0.0, 0.0, 1.0] },
      "spring":       { "$value": [0.34, 1.56, 0.64, 1.0] }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "phoneSmall":     { "$value": "320px" },
    "phoneMedium":    { "$value": "375px" },
    "phoneLarge":     { "$value": "430px" },
    "tabletPortrait": { "$value": "600px" },
    "tabletLandscape":{ "$value": "905px" },
    "desktop":        { "$value": "1240px" }
  },

  "grid": {
    "phone":  { "columns": { "$value": 4 },  "margin": { "$value": "16px" }, "gutter": { "$value": "16px" } },
    "tablet": { "columns": { "$value": 8 },  "margin": { "$value": "24px" }, "gutter": { "$value": "24px" } },
    "tabletLandscape": { "columns": { "$value": 12 }, "margin": { "$value": "32px" }, "gutter": { "$value": "24px" } }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.38 },
    "hover":    { "$value": 0.08 },
    "pressed":  { "$value": 0.12 },
    "focus":    { "$value": 0.12 },
    "dragged":  { "$value": 0.16 },
    "scrim":    { "$value": 0.48 }
  }
}
