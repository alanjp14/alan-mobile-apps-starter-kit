# ── OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDE ──────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Node (tooling in tool/) ────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build / generated artifacts ───────────────────
dist/
build/
.cache/
coverage/

# ── Flutter / Dart ────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock
pubspec_overrides.yaml
**/doc/api/
*.g.dart.orig
# generated platform scaffolding (run `flutter create .` in the app dir)
apps/*/android/
apps/*/ios/
apps/*/linux/
apps/*/macos/
apps/*/windows/
apps/*/web/
widgetbook/android/
widgetbook/ios/
widgetbook/linux/
widgetbook/macos/
widgetbook/windows/
widgetbook/web/
# bundled fonts are dropped in by the team (OFL)
packages/amds_tokens/fonts/*.ttf
test/**/failures/
**/*.log

# ── Exports (generated bundles are not committed;
#    keep the folder + its README) ─────────────────
exports/*
!exports/.gitkeep
!exports/README.md

# ── Secrets / env (never commit) ──────────────────
.env
.env.*
!.env.example
config/*.local.json
*.pem
*.p12
*.keystore
*.jks
secrets/

# ── Scratch ───────────────────────────────────────
scratch/
tmp/
*.tmp
