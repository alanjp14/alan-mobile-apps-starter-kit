# ── OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDE ──────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Node (tooling in tool/) ────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build / generated artifacts ───────────────────
dist/
build/
.cache/
coverage/

# ── Exports (generated bundles are not committed;
#    keep the folder + its README) ─────────────────
exports/*
!exports/.gitkeep
!exports/README.md

# ── Secrets / env (never commit) ──────────────────
.env
.env.*
!.env.example
config/*.local.json
*.pem
*.p12
*.keystore
*.jks
secrets/

# ── Scratch ───────────────────────────────────────
scratch/
tmp/
*.tmp
